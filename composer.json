{
  "authors": [
    {
      "email": "tomaschochola@tomaschochola.cz",
      "homepage": "https://github.com/tomaschochola",
      "name": "Tomáš Chochola",
      "role": "Author"
    }
  ],
  "autoload": {
    "psr-4": {
      "TomasChochola\\Template\\Library\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "platform-check": true,
    "policy": {
      "abandoned": {
        "audit": "fail",
        "block": true
      },
      "advisories": {
        "audit": "fail",
        "block": true
      },
      "malware": {
        "audit": "fail",
        "block": true
      }
    },
    "sort-packages": true
  },
  "description": "Template for PHP 8.5 libraries with strict static analysis, testing, and coding standards.",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tomaschochola"
    }
  ],
  "homepage": "https://github.com/tomaschochola/template-php-library",
  "keywords": [
    "tomaschochola",
    "TomasChochola",
    "Tomas Chochola",
    "Tomáš Chochola",
    "library",
    "php",
    "template",
    "tooling"
  ],
  "license": "CC-BY-ND-4.0",
  "name": "tomaschochola/template-php-library",
  "prefer-stable": true,
  "repositories": [
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/tooling-php-cs-fixer.git"
    },
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/tooling-phpstan.git"
    }
  ],
  "require": {
    "php": "^8.5.0"
  },
  "require-dev": {
    "ext-intl": "*",
    "ext-pcntl": "*",
    "ext-xdebug": "*",
    "ext-zip": "*",
    "phpunit/phpunit": "^13.0",
    "roave/security-advisories": "dev-latest",
    "tomaschochola/tooling-php-cs-fixer": "dev-main",
    "tomaschochola/tooling-phpstan": "dev-main"
  },
  "support": {
    "email": "tomaschochola@tomaschochola.cz",
    "issues": "https://github.com/tomaschochola/template-php-library/issues",
    "source": "https://github.com/tomaschochola/template-php-library.git"
  },
  "type": "library"
}
